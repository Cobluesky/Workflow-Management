{
  "name": "timetable-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:generate": "node scripts/run-prisma-workspaces.mjs generate",
    "prisma:db:push:timetable": "node scripts/run-prisma-workspaces.mjs db-push timetable",
    "prisma:db:push:core": "node scripts/run-prisma-workspaces.mjs db-push core",
