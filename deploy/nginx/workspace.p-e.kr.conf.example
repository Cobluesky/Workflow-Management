map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name app.workspace.p-e.kr auth.workspace.p-e.kr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name app.workspace.p-e.kr;

    ssl_certificate /etc/letsencrypt/live/app.workspace.p-e.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.workspace.p-e.kr/privkey.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }
}

server {
    listen 443 ssl http2;
    server_name auth.workspace.p-e.kr;

    ssl_certificate /etc/letsencrypt/live/auth.workspace.p-e.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.workspace.p-e.kr/privkey.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }
}
