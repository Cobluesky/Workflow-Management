generator client {
  provider      = "prisma-client-js"
  output        = "../generated/workspace-core"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model WorkspaceProfile {
  authUserId String   @id
  email      String
  alias      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
}

model WorkspaceModulePreference {
  id         Int      @id @default(autoincrement())
  authUserId String
  moduleId   String
  position   Int
  createdAt  DateTime @default(now())

  @@unique([authUserId, moduleId])
  @@index([authUserId, position])
}

model WorkspaceModuleState {
  authUserId                  String   @id
  workspaceModulesInitialized Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}
